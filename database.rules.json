{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".validate": "newData.hasChildren(['roomName','passwordHash','ownerUid','createdAt'])"
        },
        "files": {
          "$fileId": {
            ".validate": "newData.hasChildren(['name','size','contentType','storagePath','url','createdAt'])"
          }
        }
      }
    }
  }
}
